# Public deployment URL. Use http://localhost:5173 only for local development.
APP_ORIGIN=https://codexpulse.example.vercel.app

# Generate each secret independently; do not commit real values.
PULSE_ACCESS_TOKEN=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
RELAY_MASTER_KEY=replace-with-a-base64url-encoded-32-byte-key
CRON_SECRET=replace-with-at-least-32-random-characters

# Neon Free pooled connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Web Push VAPID values. Subject should be a mailto: address or HTTPS URL.
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:owner@example.com

# Hard caps may only lower the accepted free-tier decisions.
PULSE_MAX_HOSTS=2
PULSE_MAX_SUBSCRIPTIONS=3
PULSE_MAX_TASKS=200
PULSE_MAX_EVENTS=10000
PULSE_RETENTION_DAYS=7
